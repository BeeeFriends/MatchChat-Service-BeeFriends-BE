generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/match-chat-client"
}

datasource db {
  provider = "postgresql"
}

model MsUser {
  id              Int      @id
  displayName     String?
  binusianEmail   String?  @unique
  phoneNumber     String?
  gender          String?
  age             Int?
  binusianYear    Int?
  description     String?
  profilePhotoUrl String?
  campusId        Int?
  majorId         Int?
  isActive        Boolean  @default(true)
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campus              MsCampus?                 @relation(fields: [campusId], references: [id])
  major               MsDepartment?             @relation(fields: [majorId], references: [id])
  conversations       ConversationParticipant[]
  messages            Message[]
  sentMatchSwipes     MatchSwipe[]              @relation("SentMatchSwipes")
  receivedMatchSwipes MatchSwipe[]              @relation("ReceivedMatchSwipes")
  matchesAsFirstUser  UserMatch[]               @relation("FirstUserMatches")
  matchesAsSecondUser UserMatch[]               @relation("SecondUserMatches")
  hobbies             TrUserHobby[]
  photos              TrUserPhoto[]

  @@index([isActive])
  @@index([campusId])
  @@index([majorId])
  @@map("MsUser")
}

model MsCampus {
  id        Int      @id
  name      String
  address   String?
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  users MsUser[]

  @@index([isActive])
  @@index([name])
  @@map("MsCampus")
}

model MsDepartment {
  id        Int      @id
  name      String
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  users MsUser[]

  @@index([isActive])
  @@index([name])
  @@map("MsDepartment")
}

model MsHobby {
  id        Int      @id
  name      String
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  users TrUserHobby[]

  @@index([isActive])
  @@index([name])
  @@map("MsHobby")
}

model TrUserHobby {
  userId  Int
  hobbyId Int

  user  MsUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby MsHobby @relation(fields: [hobbyId], references: [id])

  @@id([userId, hobbyId])
  @@index([hobbyId])
  @@map("TrUserHobby")
}

model TrUserPhoto {
  userId    Int
  photoId   Int
  url       String
  sortOrder Int     @default(0)
  isProfile Boolean @default(false)

  user MsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([userId, sortOrder])
  @@map("TrUserPhoto")
}

enum MatchDecision {
  LIKE
  PASS
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
}

model Conversation {
  id                  String   @id @default(cuid())
  name                String?
  description         String?
  isGroup             Boolean  @default(false)
  lastMessageId       String?
  lastMessagePreview  String?
  lastMessageSenderId Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         MsUser       @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model MatchSwipe {
  id        String        @id @default(cuid())
  swiperId  Int
  targetId  Int
  decision  MatchDecision
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  swiper MsUser @relation("SentMatchSwipes", fields: [swiperId], references: [id])
  target MsUser @relation("ReceivedMatchSwipes", fields: [targetId], references: [id])

  @@unique([swiperId, targetId])
  @@index([targetId, decision])
  @@map("match_swipes")
}

model UserMatch {
  id             String      @id @default(cuid())
  firstUserId    Int
  secondUserId   Int
  status         MatchStatus @default(ACTIVE)
  conversationId String?     @unique
  matchedAt      DateTime    @default(now())
  unmatchedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  firstUser  MsUser @relation("FirstUserMatches", fields: [firstUserId], references: [id])
  secondUser MsUser @relation("SecondUserMatches", fields: [secondUserId], references: [id])

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, status])
  @@index([secondUserId, status])
  @@map("user_matches")
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  senderId         Int
  content          String
  attachmentUrls   String[] @default([])
  isEdited         Boolean  @default(false)
  isDeleted        Boolean  @default(false)
  readBy           Int[]    @default([])
  replyToMessageId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MsUser       @relation(fields: [senderId], references: [id])
  replyToMessage Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies        Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model PresenceSession {
  id         String   @id @default(cuid())
  userId     Int
  socketId   String   @unique
  instanceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([instanceId])
  @@map("presence_sessions")
}

model PubSubEvent {
  id        BigInt   @id @default(autoincrement())
  channel   String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([channel, id], map: "idx_pubsub_events_channel_id")
  @@map("pubsub_events")
}

model PubSubOffset {
  consumerId  String   @map("consumer_id")
  channel     String
  lastEventId BigInt   @default(0) @map("last_event_id")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@id([consumerId, channel])
  @@map("pubsub_offsets")
}
